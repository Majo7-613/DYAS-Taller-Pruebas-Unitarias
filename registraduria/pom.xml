<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>edu.unisabana.tyvs</groupId>
  <artifactId>registraduria</artifactId>
  <version>1.0-SNAPSHOT</version>

  <name>registraduria</name>
  <description>Taller de Pruebas Unitarias (TDD) - Testing y Validacion de Software</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- Si tu JDK es anterior a 17, baja este valor al de tu computador (por ejemplo 11 u 8). -->
    <maven.compiler.release>17</maven.compiler.release>
    <junit.version>5.10.2</junit.version>
    <jqwik.version>1.8.0</jqwik.version>
    <pitest.version>1.16.1</pitest.version>
    <pitest.junit5.version>1.2.1</pitest.junit5.version>
  </properties>

  <dependencies>
    <!-- Agregador completo de JUnit 5 (incluye api, engine y params alineados) -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- jqwik: pruebas basadas en propiedades -->
    <dependency>
      <groupId>net.jqwik</groupId>
      <artifactId>jqwik</artifactId>
      <version>${jqwik.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <useModulePath>false</useModulePath>
        </configuration>
      </plugin>
      <!-- (Opcional pero recomendado) JaCoCo para cobertura -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>0.8.12</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>verify</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- PIT: pruebas de mutacion.
           JaCoCo responde "que lineas se ejecutaron"; PIT responde "si el codigo
           cambia, se entera alguna prueba?". Es la unica de las dos que no se
           puede falsificar con un assertTrue(true).
           Ejecutar con: mvn test-compile org.pitest:pitest-maven:mutationCoverage -->
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>${pitest.version}</version>
        <dependencies>
          <!-- Necesario para que PIT reconozca pruebas JUnit 5. -->
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>${pitest.junit5.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <!-- Solo mutamos el dominio: es donde viven las reglas de negocio. -->
          <targetClasses>
            <param>edu.unisabana.tyvs.domain.*</param>
          </targetClasses>
          <targetTests>
            <param>edu.unisabana.tyvs.domain.*</param>
          </targetTests>
          <outputFormats>
            <param>HTML</param>
            <param>XML</param>
          </outputFormats>
          <!-- Umbral de calidad: si el mutation score baja de 60, el build falla. -->
          <mutationThreshold>60</mutationThreshold>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
